# OpenServ Reasoning. Create a key at https://console.openserv.ai
# Leave it blank to run the tests and the merchant locally without reasoning.
SERV_API_KEY=

# The settlement chain. "base" is native USDC on Base mainnet and is what the
# recorded run used. "kite" is USDC.e on Kite chain and needs a funded
# Kite Passport wallet.
SETTLEMENT_CHAIN=base

# The address that receives the payments. Put your own address here; the
# merchant refuses to start without one. The recorded run used a dedicated
# address, recorded in docs/seller.json.
PAY_TO=0x0000000000000000000000000000000000000000

# Where the agent buys from. Leave blank to use the live deployment.
SELLER_BASE_URL=
