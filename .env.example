# OpenServ Reasoning. Copy to ~/.serv/.env with mode 600. Never commit a real key.
SERV_API_KEY=

# Where the seller is reachable. The agent pays this URL.
SELLER_BASE_URL=

# The settlement chain: kite (eip155:2366) or base (eip155:8453).
SETTLEMENT_CHAIN=kite

# The address that receives the payments.
PAY_TO=
